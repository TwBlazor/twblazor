@namespace TwBlazor.Components
@typeparam T
@inherits TwBlazorInputComponentBase

<TwInputRoot RootId="@RootId" RootClass="@RootClass" RootAttributes="@RootAttributes" RootStyle="@Style" RootAriaLabel="@AriaLabel" RootAriaLabelledBy="@AriaLabelledBy" RootErrorMessage="@ErrorMessage" RootErrorId="@errorId">
    <TwInputLabel Id="@LabelId" For="@Id" Label="@Label" Class="@labelClasses" @attributes="@LabelAttributes">
        <input type="checkbox"
               id="@Id"
               name="@effectiveName"
               value="@Value"
               checked="@isChecked"
               @onchange="@HandleChange"
               class="@classes"
               disabled="@Disabled"
               @attributes="@Attributes"
               aria-readonly="@(ReadOnly ? "true" : null)"
               aria-invalid="@(Invalid ? "true" : null)"
               aria-describedby="@errorId"
               aria-label="@AriaLabel"
               aria-labelledby="@AriaLabelledBy" />
        <span class="@checkClasses">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" stroke="currentColor" stroke-width="1" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
        </span>
    </TwInputLabel>
</TwInputRoot>