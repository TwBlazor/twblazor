@namespace TwBlazor.Components
@using TwBlazor.Enums
@inherits TwBlazorComponentBase

<div id="@Id" class="@classes" style="@Style" @attributes="Attributes" aria-label="@AriaLabel" aria-labelledby="@AriaLabelledBy">
    @if (copied)
    {
        <TwIcon OnClick="@Copy" Icon="Icon.Check2" Class="p-3" RootClass="absolute right-3 mt-2" AriaLabel="Copied" />
    }
    else
    {
        <TwIcon OnClick="@Copy" Icon="Icon.Copy" Class="p-3" RootClass="absolute right-3 mt-2" AriaLabel="Copy code" />
    }
    <span class="sr-only" aria-live="polite">@statusMessage</span>
    <pre>
        <code class="@($"language-{Language}")" @ref="codeBlock">
            @Content
        </code>
    </pre>
</div>