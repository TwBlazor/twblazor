@namespace TwBlazor.Components
@inherits TwBlazorComponentBase

@if (IsParent)
{
    <button id="@Id"
        type="button"
        @onclick="OnClick"
        aria-controls="@ChildrenId"
        aria-expanded="@(IsCollapsed ? "false" : "true")"
        class="@parentClasses" style="@Style" @attributes="Attributes" aria-label="@AriaLabel" aria-labelledby="@AriaLabelledBy">
        <span class="mr-auto text-left">@Label</span>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="@($"size-5 transition-transform {(IsCollapsed ? "rotate-0" : "rotate-180")} shrink-0")" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
        </svg>
    </button>
}
else
{
    <a id="@Id" href="@Href" class="@classes" style="@Style" @attributes="Attributes" aria-label="@AriaLabel" aria-labelledby="@AriaLabelledBy" aria-current="@(isActive ? "page" : null)">
        <span>@Label</span>
    </a>
}