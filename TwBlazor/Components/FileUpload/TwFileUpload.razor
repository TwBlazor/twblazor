
@using Microsoft.AspNetCore.Components.Forms
@using TwBlazor.Enums
@namespace TwBlazor.Components
@inherits TwBlazorInputComponentBase

<TwInputRoot RootId="@RootId" RootClass="@rootClasses" RootAttributes="@RootAttributes" RootStyle="@Style" RootAriaLabel="@AriaLabel" RootAriaLabelledBy="@AriaLabelledBy" RootErrorMessage="@ErrorMessage" RootErrorId="@errorId">
    <TwInputLabel Id="@LabelId" For="@Id" Label="@Label" OverrideClass="@classes" @attributes="@LabelAttributes">
        @if (Icon != null)
        {
            <TwIcon Icon="@((Icon)Icon)" Class="me-2"/>
        }

        @if (Multiple)
        {
            <InputFile id="@Id" OnChange="@OnUpload" multiple @attributes="@Attributes" disabled="@Disabled" class="sr-only peer" aria-readonly="@(ReadOnly ? "true" : null)" aria-invalid="@(Invalid ? "true" : null)" aria-describedby="@errorId" aria-label="@AriaLabel" aria-labelledby="@AriaLabelledBy" />
        }
        else
        {
            <InputFile id="@Id" OnChange="@OnUpload" @attributes="@Attributes" disabled="@Disabled" class="sr-only peer" aria-readonly="@(ReadOnly ? "true" : null)" aria-invalid="@(Invalid ? "true" : null)" aria-describedby="@errorId" aria-label="@AriaLabel" aria-labelledby="@AriaLabelledBy" />
        }
    </TwInputLabel>
    
    @if (selectedFiles.Count > 0)
    {
        <div class="text-sm text-gray-600 mt-3 gap-2 block">
            @foreach (var f in selectedFiles)
            {
                <TwChip Label="@f.Name" Closable OnClose="() => RemoveFile(f)" Shadow="Enums.Shadow.None" Class="me-2 mb-2 dark:text-white" />
            }
        </div>
    }
</TwInputRoot>
