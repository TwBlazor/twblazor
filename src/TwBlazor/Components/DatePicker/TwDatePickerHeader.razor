@using TwBlazor.Enums
@inherits TwBlazorComponentBase

<div class="@classes">
    <div class="@headerControlsClasses">
        <TwIcon OnClick="@OnPreviousClick" Icon="Icon.Arrow_Left" RootClass="prev-btn" Class="text-xl py-2 px-4" AriaLabel="@PreviousLabel" Shadow="Enums.Shadow.None" Disabled="@PreviousDisabled" />

        <TwButton OnClick="@OnTitleClick" Variant="ButtonVariant.Text" Class="@titleButtonClasses">
            @ChildContent
        </TwButton>

        <TwIcon OnClick="@OnNextClick" Icon="Icon.Arrow_Right" RootClass="next-btn" Class="text-xl py-2 px-4" AriaLabel="@NextLabel" Shadow="Enums.Shadow.None" Disabled="@NextDisabled" />
    </div>
    @* Visually-hidden live region so screen readers announce the new month/year/decade whenever
       navigation changes the title above, without altering the visible header's styling. *@
    <div class="@options.Theme.Display.ScreenReaderOnly" aria-live="polite">@ChildContent</div>
</div>