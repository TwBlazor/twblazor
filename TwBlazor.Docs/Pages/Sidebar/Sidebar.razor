@page "/sidebar"

<PageTitle>TwSidebar | twblazor</PageTitle>
<HeadContent>
    <meta name="description" content="TwSidebar is a Blazor sidebar component for application navigation, built from static markup or from data driven navigation items." />
    <link rel="canonical" href="https://twblazor.com/sidebar" />
</HeadContent>

<PageContainer Title="TwSidebar">
    <PageCard Title="Basic Sidebar">
        <p class="my-3">
            <code>TwSidebar</code> has all the functionality you'd want in a single component for a sidebar. You can customise the sidebar using both tailwind classes and additional TwBlazor Theme styling.
        </p>
        <iframe src="/sidebar/preview" class="w-full h-[200px] border-0 rounded-lg"></iframe>
        <ExampleCodeBlock Razor="@CodeExamples.Get("SidebarBasic")" />
    </PageCard>

    <PageCard Title="Data-Driven Navigation (Programmatic)">
        <p class="my-3">
            Instead of hand-writing <code>SidebarContent</code> markup, pass a <code>List&lt;NavigationItem&gt;</code> to <code>NavigationItems</code> and TwSidebar renders the links, nested groups, and (with <code>IsSearchable</code>) a search box for you - this is exactly how this documentation site's own sidebar is built, see <code>Navigation.razor.cs</code>.
        </p>
        <iframe src="/sidebar/preview-navigation" class="w-full h-[280px] border-0 rounded-lg"></iframe>
        <ExampleCodeBlock Razor="@CodeExamples.Get("SidebarNavigationItems")" CSharp="@CodeExamples.Get("SidebarNavigationItemsCode")" />
    </PageCard>
</PageContainer>