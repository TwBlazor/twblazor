@ChildContent

<ExampleCodeBlock Razor="@Code" CSharp="@CSharpCode" />

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter] public string? CSharpName { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string Code => CodeExamples.Get(Name);
    private string CSharpCode => CSharpName is null ? string.Empty : CodeExamples.Get(CSharpName);
}
