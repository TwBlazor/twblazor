<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TwBlazor\TwBlazor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\css\codeblockDark.css">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\css\codeblockLight.css">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\css\output.css">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\fonts\source-sans-3-v19-latin-700.woff2">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\fonts\source-sans-3-v19-latin-900.woff2">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\fonts\source-sans-3-v19-latin-regular.woff2">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\images\logo.svg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\js\highlight.min.js">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\js\themeToggle.js">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\source-files\Theme.cs">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Auto-generate CodeExamples.cs from TwBlazor.BuildTools before build -->
  <Target Name="GenerateDefaultTheme" BeforeTargets="BeforeBuild" Condition="'$(CF_PAGES)' != '1'">
    <Message Text="Running TwBlazor build tools..." Importance="high" />
    <Exec Command="dotnet run --project $(MSBuildThisFileDirectory)../TwBlazor.BuildTools/TwBlazor.BuildTools.csproj" WorkingDirectory="$(MSBuildThisFileDirectory).." />
  </Target>

  <!-- Explicit Include: the default glob is evaluated before GenerateDefaultTheme
       runs, so on a clean checkout it wouldn't otherwise see this generated file. -->
  <ItemGroup>
    <Compile Remove="Generated\**" />
    <Compile Include="Generated\CodeExamples.cs" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\fonts\" />
  </ItemGroup>

</Project>
