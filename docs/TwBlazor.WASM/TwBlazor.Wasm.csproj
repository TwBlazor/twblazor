<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Routes.razor, not the SDK's default "App", is the root component. -->
    <BlazorWasmPrerenderingRootComponentType>TwBlazor.Wasm.Routes</BlazorWasmPrerenderingRootComponentType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="BlazorWasmPreRendering.Build" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TwBlazor.Docs\TwBlazor.Docs.csproj" />
    <ProjectReference Include="..\..\src\TwBlazor.Theme\TwBlazor.Theme.csproj" />
  </ItemGroup>

</Project>
