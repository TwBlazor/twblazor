@page "/breadcrumb"
@using TwBlazor.Models

<PageTitle>TwBreadcrumb | twblazor</PageTitle>
<HeadContent>
    <meta name="description" content="TwBreadcrumb is a Blazor breadcrumb component that shows the current page location. Supports automatic, manual and inline breadcrumbs." />
    <link rel="canonical" href="https://twblazor.com/breadcrumb" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="twblazor" />
    <meta property="og:title" content="TwBreadcrumb | twblazor" />
    <meta property="og:description" content="TwBreadcrumb is a Blazor breadcrumb component that shows the current page location. Supports automatic, manual and inline breadcrumbs." />
    <meta property="og:url" content="https://twblazor.com/breadcrumb" />
    <meta property="og:image" content="https://twblazor.com/_content/TwBlazor.Docs/images/logo.svg" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="TwBreadcrumb | twblazor" />
    <meta name="twitter:description" content="TwBreadcrumb is a Blazor breadcrumb component that shows the current page location. Supports automatic, manual and inline breadcrumbs." />
    <meta name="twitter:image" content="https://twblazor.com/_content/TwBlazor.Docs/images/logo.svg" />
</HeadContent>

<PageContainer Title="TwBreadcrumb" ThemeType="typeof(TwBreadcrumbTheme)">
    <PageCard Title="Breadcrumbs">
        <Description>Usage of breadcrumb is simplified, you can use the component and allow for automatic breadcrumbs based on the current uri structure:</Description>

        <CodeExample Name="BreadcrumbAuto">
            <TwBreadcrumb Auto />
        </CodeExample>
    </PageCard>

    <PageCard Title="Manual Breadcrumbs">
        <Description>You can also manually configure the breadcrumbs:</Description>

        <CodeExample Name="BreadcrumbManual" CSharpName="BreadcrumbManualCode">
            <TwBreadcrumb Breadcrumbs="@breadcrumbs" />
        </CodeExample>
    </PageCard>

    <PageCard Title="Inline Breadcrumbs">
        <Description>You can also manually configure the breadcrumbs inline like so:</Description>

        <CodeExample Name="BreadcrumbInline">
            <TwBreadcrumb>
                <TwBreadcrumbItem Label="Home" Href="/" />
                <TwBreadcrumbItem Label="Docs" Href="/" />
                <TwBreadcrumbItem Label="Breadcrumb" Href="/breadcrumb" Icon="Icon.Segmented_Nav" AriaCurrent />
            </TwBreadcrumb>
        </CodeExample>
    </PageCard>
</PageContainer>

@code {
    #region CodeExample BreadcrumbManualCode
    private readonly List<BreadcrumbItem> breadcrumbs = new()
    {
        new()
        {
            Icon = Icon.House,
            Label = "Home",
            Href = "/"
        },
        new ()
        {
            Icon = Icon.Wrench,
            Label = "Settings",
            Href = "/"
        }
    };
    #endregion
}