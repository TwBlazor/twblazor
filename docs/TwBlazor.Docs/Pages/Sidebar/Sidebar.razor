@page "/sidebar"

<PageTitle>TwSidebar | twblazor</PageTitle>
<HeadContent>
    <meta name="description" content="TwSidebar is a Blazor sidebar component for application navigation, built from static markup or from data driven navigation items." />
    <link rel="canonical" href="https://twblazor.com/sidebar" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="twblazor" />
    <meta property="og:title" content="TwSidebar | twblazor" />
    <meta property="og:description" content="TwSidebar is a Blazor sidebar component for application navigation, built from static markup or from data driven navigation items." />
    <meta property="og:url" content="https://twblazor.com/sidebar" />
    <meta property="og:image" content="https://twblazor.com/_content/TwBlazor.Docs/images/logo.svg" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="TwSidebar | twblazor" />
    <meta name="twitter:description" content="TwSidebar is a Blazor sidebar component for application navigation, built from static markup or from data driven navigation items." />
    <meta name="twitter:image" content="https://twblazor.com/_content/TwBlazor.Docs/images/logo.svg" />
</HeadContent>

<PageContainer Title="TwSidebar" ThemeType="typeof(TwSidebarTheme)">
    <PageCard Title="Basic Sidebar">
        <Description>
            <code>TwSidebar</code> has all the functionality you'd want in a single component for a sidebar. You can customise the sidebar using both tailwind classes and additional TwBlazor Theme styling.
        </Description>
        <iframe src="/sidebar/preview" title="TwSidebar basic example preview" class="w-full h-50 border-0 rounded-lg"></iframe>
        <ExampleCodeBlock Razor="@CodeExamples.Get("SidebarBasic")" />
    </PageCard>

    <PageCard Title="Data-Driven Navigation (Programmatic)">
        <Description>
            Instead of hand-writing <code>SidebarContent</code> markup, pass a <code>List&lt;NavigationItem&gt;</code> to <code>NavigationItems</code> and TwSidebar renders the links, nested groups, and (with <code>IsSearchable</code>) a search box for you - this is exactly how this documentation site's own sidebar is built, see <code>Navigation.razor.cs</code>.
        </Description>
        <iframe src="/sidebar/preview-navigation" title="TwSidebar data-driven navigation example preview" class="w-full h-50 border-0 rounded-lg"></iframe>
        <ExampleCodeBlock Razor="@CodeExamples.Get("SidebarNavigationItems")" CSharp="@CodeExamples.Get("SidebarNavigationItemsCode")" />
    </PageCard>
</PageContainer>