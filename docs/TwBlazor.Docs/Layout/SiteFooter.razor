@using IconEnum = TwBlazor.Enums.Icon

<footer class="mt-16 border-t border-purple-200/70 dark:border-purple-900/60 bg-gradient-to-b from-transparent to-purple-50/70 dark:to-purple-950/30">
    <nav aria-label="Footer" class="flex flex-wrap items-center justify-center gap-x-1 gap-y-1 px-6 pt-6 pb-2 text-sm font-medium">
        <a href="@GitHubUrl" target="_blank" rel="noopener noreferrer" class="@linkClasses">
            <TwIcon Icon="IconEnum.Github" />
            GitHub<span class="sr-only"> (opens in a new tab)</span>
        </a>
        <span aria-hidden="true" class="text-purple-400 dark:text-purple-700">&bull;</span>
        <a href="@DocumentationUrl" target="_blank" rel="noopener noreferrer" class="@linkClasses">
            <TwIcon Icon="IconEnum.Book" />
            Documentation<span class="sr-only"> (opens in a new tab)</span>
        </a>
        <span aria-hidden="true" class="text-purple-400 dark:text-purple-700">&bull;</span>
        <a href="@LicenseUrl" target="_blank" rel="noopener noreferrer" class="@linkClasses">
            <TwIcon Icon="IconEnum.File_Earmark_Text" />
            MIT License<span class="sr-only"> (opens in a new tab)</span>
        </a>
    </nav>
    <p class="flex items-center justify-center gap-1.5 px-6 pb-6 text-xs text-purple-700/70 dark:text-purple-300/60">
        <TwIcon Icon="IconEnum.Heart_Fill" Class="text-purple-400 dark:text-purple-500" />
        twblazor is and always will be free and open source.
    </p>
</footer>

@code {
#pragma warning disable S1075 // Fixed external project links, not environment-specific
    /// <summary>Gets the URL of the GitHub project.</summary>
    public const string GitHubUrl = "https://github.com/TwBlazor/twblazor";

    /// <summary>Gets the URL of the API documentation.</summary>
    public const string DocumentationUrl = "https://twblazor.github.io/twblazor/";

    /// <summary>Gets the URL of the MIT license file.</summary>
    public const string LicenseUrl = "https://github.com/TwBlazor/twblazor/blob/develop/LICENSE.txt";
#pragma warning restore S1075

    private const string linkClasses = "inline-flex items-center gap-2 rounded-md px-2.5 py-1 text-purple-900 dark:text-purple-200 transition-colors duration-150 hover:bg-purple-100 hover:text-purple-700 dark:hover:bg-purple-900/40 dark:hover:text-purple-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600 dark:focus-visible:outline-purple-400";
}
